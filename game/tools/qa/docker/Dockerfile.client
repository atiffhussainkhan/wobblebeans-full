# Production client. Vite bakes VITE_SERVER_URL into the bundle.
FROM node:22-bookworm-slim AS build

ARG CLIENT_VERSION=0.1.0
ARG PROTOCOL=1
ARG VITE_SERVER_URL=ws://127.0.0.1:47221
ENV VITE_SERVER_URL=${VITE_SERVER_URL}

WORKDIR /app
RUN corepack enable && corepack prepare pnpm@10.33.4 --activate

COPY package.json pnpm-lock.yaml pnpm-workspace.yaml ./
COPY apps ./apps
COPY packages ./packages
COPY tools ./tools
COPY assets ./assets

RUN pnpm install --frozen-lockfile --filter @wobblebeans/client... \
  && pnpm --filter @wobblebeans/client build

FROM nginx:1.27-alpine

ARG CLIENT_VERSION=0.1.0
ARG PROTOCOL=1
LABEL org.opencontainers.image.title="wobblebeans-client" \
      org.opencontainers.image.version="${CLIENT_VERSION}" \
      org.wobblebeans.protocol="${PROTOCOL}"

RUN apk add --no-cache wget
COPY tools/qa/docker/nginx.conf /etc/nginx/conf.d/default.conf
COPY --from=build /app/apps/client/dist /usr/share/nginx/html
EXPOSE 80

HEALTHCHECK --interval=10s --timeout=3s --start-period=5s --retries=3 \
  CMD wget -q -O /dev/null http://127.0.0.1/ || exit 1
